[Unit]
Description=MeMemo ASN 补推没发出去的提醒 + 清理过期记录
Documentation=https://github.com/AaronYu2017/MeMemo-support/tree/main/cn/asn

[Service]
Type=oneshot
User=mememo-asn
Group=mememo-asn
EnvironmentFile=/etc/mememo-asn.env
WorkingDirectory=/opt/mememo-asn
StateDirectory=mememo-asn
ExecStart=/opt/mememo-asn/venv/bin/python asn.py drain
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
