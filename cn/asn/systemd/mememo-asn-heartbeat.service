[Unit]
Description=MeMemo ASN 心跳：让 Apple 发一条测试通知，验证整条管线活着
Documentation=https://github.com/AaronYu2017/MeMemo-support/tree/main/cn/asn
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mememo-asn
Group=mememo-asn
EnvironmentFile=/etc/mememo-asn.env
WorkingDirectory=/opt/mememo-asn
StateDirectory=mememo-asn
TimeoutStartSec=300
ExecStart=/opt/mememo-asn/venv/bin/python asn.py heartbeat
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
