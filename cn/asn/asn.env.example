# 复制成 cn/asn/asn.env 并填真实值（该文件不进 git；本仓库是公开的）。
# deploy-asn.sh 会把它装到服务器的 /etc/mememo-asn.env（0640 root:mememo-asn）。

# 端点路径里那段不可猜的 token。生成：openssl rand -hex 16
# 换掉它就必须同步改 App Store Connect 里的两个 URL，否则通知全部 404。
ASN_PATH_TOKEN=

# Bark 的推送地址。**整条 URL 直接粘进来就行**，代码会自己取出 key：
#   打开手机 Bark -> 「服务器」页第一张卡片 -> 右上角复制图标
#   粘进来长这样：https://api.day.app/xxxxxxxxxxxx/这里改成你自己的推送内容
# 想只填中间那段裸 key 也可以，两种都认。只有它是密钥，其余都不是。
ASN_BARK_KEY=
ASN_BARK_BASE=https://api.day.app

# App 侧参数，一般不用改
ASN_BUNDLE_ID=com.aaronyu.mememo
ASN_APP_APPLE_ID=6760353728

# 在线吊销检查（OCSP）。默认 0=关，理由见 asn.py 里的注释。
ASN_ONLINE_CHECKS=0

# 记录保留天数。对账用不到更久，而留着的是交易号/金额/地区这类数据，
# 没有理由永久存。只清已推送的；没推出去的一直留着（那是看得见的信号）。
ASN_RETENTION_DAYS=90

# ---- 心跳用（第二阶段，等 In-App Purchase API 密钥生成后再填）----
# App Store Connect -> 用户和访问 -> 集成 -> App 内购买项目 -> 生成密钥
# 注意：这是**独立于** App Store Connect API 密钥的另一种密钥。
ASN_IAP_KEY_ID=
ASN_IAP_ISSUER_ID=
ASN_IAP_KEY_PATH=/etc/mememo-asn-iap.p8
