# App Store Server Notifications V2 的接收端点。
#
# 由 cn/asn/deploy-asn.sh 生成，__ASN_TOKEN__ 从 cn/asn/asn.env 填入（不进 git）。
# 站点主配置用 `include /etc/nginx/snippets/mememo-asn*.conf;` 通配引入 ——
# 通配的意义是：这个服务没部署时匹配不到任何文件，nginx 照常启动，
# 网站不会因为一个附属服务没装而下线。
#
# 挂在已备案的 www.mememo.com.cn 下的一个路径，**刻意不新开子域名**：
# 新子域名要动备案。这里也不触碰号-2 承诺的「禁 UGC 与站内交易」——
# 交易发生在 App Store，这个端点只接收 Apple 的通知。

location /asn/__ASN_TOKEN__/ {
    # Apple 只会 POST。其余方法在 nginx 层就挡掉，不进 Python。
    limit_except POST { deny all; }
    client_max_body_size 1m;

    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;

    access_log /var/log/nginx/asn.access.log;
}
